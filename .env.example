# Скопируйте в .env (cp .env.example .env) и заполните.
# .env никогда не попадает в git и не пересылается в чат.

# --- База данных (контейнер db) ---
POSTGRES_USER=olymp
POSTGRES_DB=olymp
# Сгенерировать: openssl rand -hex 24   (только буквы и цифры — пароль
# подставляется в адрес подключения)
POSTGRES_PASSWORD=

# --- Сайт ---
BASE_URL=https://lk.olymp.kazan-math.info
# Сгенерировать: openssl rand -hex 32
SECRET_KEY=
# Сколько дней живёт вход в кабинет
SESSION_DAYS=45

# --- Telegram: бот олимпиады из Botmother ---
# Токен: @BotFather -> /mybots -> бот -> API Token.
# НЕ нажимайте там Revoke — иначе бот в Botmother перестанет работать.
TELEGRAM_BOT_TOKEN=
# Имя бота без @
TELEGRAM_BOT_USERNAME=

# --- MAX: бот для входа ---
MAX_BOT_TOKEN=
# Имя бота, как в ссылке https://max.ru/<имя>
MAX_BOT_USERNAME=
# Сгенерировать: openssl rand -hex 32
MAX_WEBHOOK_SECRET=

# --- Согласие на обработку ПДн ---
# Увеличивать при каждой правке текста app/templates/consent.html
CONSENT_VERSION=2026-10-draft

# --- Отборочный тур (московское время, формат 2026-12-06 10:00) ---
# Пока QUAL_OPENS_AT пусто, тест закрыт, а данные детей можно менять.
QUAL_OPENS_AT=
QUAL_CLOSES_AT=

# Ссылки на Яндекс.Формы по классам; {code} заменится на код участника.
FORM_URL_GRADE_2=
FORM_URL_GRADE_3=
FORM_URL_GRADE_4=
FORM_URL_GRADE_5=
FORM_URL_GRADE_6=
